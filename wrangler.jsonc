{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nuclear-cyborg-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-11",
  // Mirrors what the Cloudflare dashboard shows for this Worker. A deploy sends
  // this block as part of the script metadata, so anything toggled in the
  // dashboard but missing here is liable to be reset on the next deploy —
  // traces especially, which the dashboard turns on and this file did not have.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Only these paths reach worker/index.js; everything else is served straight from the asset bundle.
    "run_worker_first": [
      "/apps/scheduler/callback-threads-uninstall",
      "/apps/scheduler/callback-threads-delete",
      "/apps/scheduler/apply"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Hostname a Turnstile token must have been minted on. Checked against the
  // `hostname` siteverify reports, so a token issued for some other host on the
  // widget can't be replayed here. Not a secret; .dev.vars overrides it locally.
  "vars": {
    "TURNSTILE_HOSTNAME": "nuclearcyborg.com"
  },
  // Per-IP throttle in front of the public application endpoint. `period` may
  // only be 10 or 60; counters are per Cloudflare location, so the effective
  // global rate is higher than `limit` and this is a flood brake, not a quota.
  // The namespace is account-wide, so this deliberately isn't the "1001" from
  // Cloudflare's docs — another Worker here starting from the same example
  // would otherwise share these counters.
  "ratelimits": [
    {
      "name": "APPLY_RATE_LIMITER",
      "namespace_id": "7742",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  // Storage for "Get started" applications. Create the database once with
  //   npx wrangler d1 create scheduler-applications
  // then paste the returned database_id here and apply db/migrations with
  //   npx wrangler d1 migrations apply scheduler-applications --remote
  "d1_databases": [
    {
      "binding": "SCHEDULER_APPLICATIONS_DB",
      "database_name": "scheduler-applications",
      "database_id": "69ac639b-08f0-4828-9ec4-7f1e55d0bd32",
      "migrations_dir": "db/migrations"
    }
  ]
}
